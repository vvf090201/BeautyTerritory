@model Lab4_MVC_App.Models.Product

@{
    ViewData["Title"] = "Удалить";
}

<h2 class="mt-4 text-danger">Удалить товар? 🥺</h2>

<div class="mt-3">
    <h4>Вы уверены, что хотите удалить <strong>@Model.Name</strong>?</h4>
    <form asp-action="Delete" class="mt-4">
        <!-- Скрытое поле для ID -->
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Да, удалить" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
    </form>
</div>