@model Lab4_MVC_App.Models.Product

@{
    ViewData["Title"] = "Добавить новинку";
}

<h2 class="mt-4">Добавить новинку 🌸</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" class="mt-3">
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Название</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Brand" class="control-label">Бренд</label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Category" class="control-label">Категория</label>
                <input asp-for="Category" class="form-control" placeholder="Уход, Макияж, Парфюм..." />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label">Цена (руб.)</label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Описание</label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Emoji" class="control-label">Эмодзи (иконка)</label>
                <input asp-for="Emoji" class="form-control" placeholder="Например: 💄 или 🧴" />
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Добавить" class="btn btn-pink" />
                <a asp-action="Index" class="btn btn-outline-secondary">Назад к каталогу</a>
            </div>
        </form>
    </div>
</div>