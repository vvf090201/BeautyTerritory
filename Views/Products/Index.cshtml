@model IEnumerable<Lab4_MVC_App.Models.Product>

@{
    ViewData["Title"] = "Каталог красоты";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h1>✨ Каталог красоты ✨</h1>
    <a asp-action="Create" class="btn btn-pink btn-lg">Добавить товар</a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="product-card">
                <div class="emoji-icon">@item.Emoji</div>
                <div class="text-center">
                    <span class="badge-category">@item.Category</span>
                </div>
                <h4 class="text-center mt-2">@item.Name</h4>
                <p class="text-center text-muted">@item.Brand</p>
                <p class="text-center small">@item.Description</p>
                
                <div class="price text-center mb-3">@item.Price.ToString("C0", new System.Globalization.CultureInfo("ru-RU"))</div>
                
                <div class="d-flex justify-content-between">
                    <div>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm text-warning" title="Редактировать">✏️</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm text-danger" title="Удалить">🗑️</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>